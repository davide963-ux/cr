# URL pubblico del sito (usato per canonical, sitemap, Open Graph).
# Il dominio di produzione, senza barra finale.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase: accesso, profili, saldi ---
# Si trovano su supabase.com → progetto → Project Settings → API.
# Senza queste due il sito funziona lo stesso, ma non c'è accesso: /accedi e
# /registrati mostrano un avviso al posto del modulo.
#
# La chiave "anon" è pensata per il browser ed è protetta dalle policy RLS.
# La chiave "service_role" NON va messa qui e non va MAI esposta al client:
# scavalca ogni policy, comprese quelle che impediscono a un utente di
# modificarsi il saldo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
